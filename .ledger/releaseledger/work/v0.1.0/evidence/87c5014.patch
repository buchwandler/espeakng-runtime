+# Build and publish a Python package when a GitHub Release is published.
+
+name: Upload Python Package
+
+on:
+  release:
+    types: [published]
+
+permissions:
+  contents: read
+
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Check out release
+        uses: actions/checkout@v7
+
+      - name: Set up Python
+        uses: actions/setup-python@v7
+        with:
+          python-version: "3.13"
+
+      - name: Install build tooling
+        run: python -m pip install --upgrade pip build twine
+
+      - name: Build package
+        run: |
+          rm -rf dist
+          python -m build
+          python -m pip install "$(find dist -maxdepth 1 -name '*.whl' -print -quit)"
+          python scripts/check_release_artifacts.py \
+            --wheel "$(find dist -maxdepth 1 -name '*.whl' -print -quit)" \
+            --sdist "$(find dist -maxdepth 1 -name '*.tar.gz' -print -quit)" \
+            --release
+          python -m twine check dist/*
+
+      - name: Publish package to PyPI
+        uses: pypa/gh-action-pypi-publish@v1.14.1
+        with:
+          password: ${{ secrets.PYPI_API_TOKEN }}
+          attestations: false
